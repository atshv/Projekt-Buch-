#!/usr/bin/env bash
# Führt einen Befehl aus und legt das Ergebnis als Nachweis ab.  Aufruf: bin/record-test <Karten-ID> [-p A1,A2] -- <Befehl>
# Beispiel: bin/record-test T05 -p A1,A2 -- npm test   Ablage: docs/handoff/nachweise/<ID>-JJJJMMTT-HHMMSS.md
# -p nennt die Abnahmepunkte der Karte, die der Lauf belegt. Der Nachweis enthält Arbeitsstand und Prüfsumme,
# damit bin/check-done erkennt, ob er noch zum Code passt. Nie überschrieben, Fehlschläge werden festgehalten.
# Der Exit-Code des Befehls wird durchgereicht (0 = bestanden).
set -uo pipefail
cd "$(dirname "$0")/.."

ID="${1:-}"
if [ -z "$ID" ] || [ "$ID" = "--help" ] || [ "$ID" = "-h" ]; then
  sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0
fi
shift
PUNKTE="-"
if [ "${1:-}" = "-p" ]; then
  PUNKTE=$(printf '%s' "${2:-}" | tr -d ' ')
  echo "$PUNKTE" | grep -Eq '^A[0-9]+(,A[0-9]+)*$' || { echo "Ungültige Abnahmepunkte: ${2:-} (erwartet z. B. A1,A2)"; exit 2; }
  shift 2
fi
if [ "${1:-}" = "--" ]; then shift; fi
[ $# -gt 0 ] || { echo "Es fehlt der Befehl. Aufruf: bin/record-test <Karten-ID> -- <Befehl>"; exit 2; }
echo "$ID" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$' || { echo "Ungültige Kennung: $ID (erlaubt: Buchstaben, Ziffern, . _ -)"; exit 2; }

hashen() { # Prüfsumme von stdin
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -c1-32
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -c1-32
  else cksum | tr -d ' '; fi
}
stand_hash() { # Fingerabdruck der Arbeitsdateien, ohne docs/handoff/ und PLAN.md
  git ls-files -c -o --exclude-standard 2>/dev/null | sort -u | while IFS= read -r f; do
    case "$f" in docs/handoff/*|docs/plan/PLAN.md) continue ;; esac
    [ -f "$f" ] || continue
    printf '%s %s\n' "$f" "$(hashen < "$f")"
  done | hashen
}

ZIEL="docs/handoff/nachweise"
mkdir -p "$ZIEL"
ROH=$(mktemp)
trap 'rm -f "$ROH"' EXIT

ZEIT=$(date '+%Y-%m-%d %H:%M:%S %z')
STEMPEL=$(date '+%Y%m%d-%H%M%S')

"$@" 2>&1 | tee "$ROH"
CODE=${PIPESTATUS[0]}

if [ "$CODE" -eq 0 ]; then ERGEBNIS="bestanden"; else ERGEBNIS="fehlgeschlagen"; fi

# Stand des Projekts
if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  STAND="Commit $(git rev-parse --short HEAD), $(git status --porcelain | wc -l | tr -d ' ') ungesicherte Dateien"
else
  STAND="noch kein Commit"
fi

# Test der Karte aus dem Plan (nur wenn die Kennung eine Karte ist)
KARTENTEST="(keine Karte $ID in docs/plan/PLAN.md)"
if [ -f docs/plan/PLAN.md ]; then
  T=$(awk -v id="$ID" '
    $0 ~ "^### " id ":" { drin = 1; next }
    drin && /^##/ { exit }
    drin && /^- Test:/ { sub(/^- Test:[ \t]*/, ""); print; exit }
  ' docs/plan/PLAN.md)
  if [ -n "$T" ]; then KARTENTEST="$T"
  elif grep -q "^### $ID:" docs/plan/PLAN.md; then KARTENTEST="siehe Abnahme der Karte $ID"; fi
fi

# Ausgabe säubern (Farbcodes, Zeilenenden) und auf die letzten 100 Zeilen kürzen
ESC=$(printf '\033')
SAUBER=$(mktemp)
sed "s/${ESC}\\[[0-9;]*[A-Za-z]//g" "$ROH" | tr -d '\r' > "$SAUBER"
N_ZEILEN=$(wc -l < "$SAUBER" | tr -d ' ')
if [ "$N_ZEILEN" -gt 100 ]; then
  HINWEIS="gekürzt: letzte 100 von $N_ZEILEN Zeilen"
else
  HINWEIS="vollständig: $N_ZEILEN Zeilen"
fi

if git rev-parse --git-dir >/dev/null 2>&1; then ARBEITSSTAND=$(stand_hash); else ARBEITSSTAND="kein-git"; fi

DATEI="$ZIEL/$ID-$STEMPEL.md"
N=2
while [ -e "$DATEI" ]; do DATEI="$ZIEL/$ID-$STEMPEL-$N.md"; N=$((N + 1)); done

{
  echo "# Nachweis $ID"
  echo
  echo "- Karte: $ID"
  echo "- Zeit: $ZEIT"
  echo "- Befehl: \`$*\`"
  echo "- Ergebnis: $ERGEBNIS (Exit-Code $CODE)"
  echo "- Stand: $STAND"
  echo "- Test der Karte: $KARTENTEST"
  echo "- Abnahme: ${PUNKTE//,/, }"
  echo "- Arbeitsstand: $ARBEITSSTAND"
  echo
  echo "## Ausgabe ($HINWEIS)"
  echo
  echo '````text'
  tail -n 100 "$SAUBER"
  echo '````'
} > "$DATEI"
echo "Prüfsumme: $(hashen < "$DATEI")" >> "$DATEI"
rm -f "$SAUBER"

echo
echo "Nachweis: $DATEI ($ERGEBNIS)"
exit "$CODE"

#!/usr/bin/env bash
# Legt einen neuen Skill an.  Aufruf: bin/new-skill <name>
# name: nur a-z, 0-9 und Bindestrich, z. B. bericht-schreiben
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "${1:-}" = "" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,3p' "$0" | sed 's/^# //'; exit 0
fi
NAME="$1"
if ! echo "$NAME" | grep -Eq '^[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "Ungültiger Name: nur a-z, 0-9, Bindestrich"; exit 1
fi
DIR="toolkit/skills/$NAME"
[ -e "$DIR" ] && { echo "Gibt es schon: $DIR"; exit 1; }
mkdir -p "$DIR/tests"
cat > "$DIR/SKILL.md" <<SKILL
---
name: $NAME
description: [Was der Skill tut, 1 Satz]. Nutze diesen Skill, wenn [Situationen] oder der
  Mensch [Stichworte] sagt, auch wenn [Sonderfall]. Nicht für [nahe Fehlgriffe].
---

# $NAME

[Zweck in 1 bis 2 Sätzen.]

## Kurzstart
- Wann: [..]
- Ergebnis: [Datei, Ort, Name]
- Schnellweg: [..]

## Benötigte Eingaben
- [..]

## Ablauf
1. [Verb] [Objekt]. Ergebnis: [überprüfbar].
2. [Verb] [Objekt]. Ergebnis: [überprüfbar].

## Ausgabe
- [Ort, Dateiname, Chat-Meldung]

## Qualitätstor
- [ ] [..]

## Verwandte Skills
- [..]

## Nicht tun
- Nie [..], weil [..]. Stattdessen: [..].
SKILL
printf '# Testaufträge\n1. [realistischer Auftrag]\n2. [..]\n3. [..]\n' > "$DIR/tests/prompts.md"
printf '# Auslösesätze\nJA: [..]\nNEIN: [..]\n' > "$DIR/tests/trigger-queries.md"
echo "Angelegt: $DIR"
echo "Weiter: Platzhalter ausfüllen (oder toolkit/skills/skill-creator/SKILL.md nutzen),"
echo "        Zeile in toolkit/skills/SKILLMAP.md ergänzen, dann bin/check-skills"
